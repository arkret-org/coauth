# The Dockerfile uses the repository parent as its build context.
# Keep sibling manifests, locks, migrations and source resources available.
**/target/
**/.shared-target/
**/node_modules/
**/.sqlx/
**/.git/
**/.local/
**/.ssh/
**/.gnupg/
**/.codex-tmp/
**/.claude/
**/.devcontainer/
**/.env
**/.env.*
**/*.log

# Repository-root evidence may contain private test custody. Formal Spec
# artifacts under arkret-spec/spec/v1/artifacts remain source inputs.
coauth/artifacts/
coland/artifacts/
cotest/artifacts/
arkret-rust-sdk/artifacts/
garth/artifacts/
floria/artifacts/
bridges/artifacts/

# Locally provisioned credentials and generated integration configuration.
# Credential mounts live at context/repository roots; nested Rust modules
# named secrets are source inputs.
secrets/
*/secrets/
**/.secrets/
coauth/conformance/test-config.yaml
coauth/conformance/test-config.yaml.raw

# Coauth build outputs and documentation are not image inputs.
coauth/dist/
coauth/docs/
coauth/docs-zh/
